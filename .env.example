# Copy to .env.local and fill in. Never commit real values.

# ElevenLabs API key, used by GET /api/voices to list the voices available
# to your account. Create one at https://elevenlabs.io/app/settings/api-keys
#
# Optional: the avatar demo plays pre-rendered audio from public/audios and
# runs fine without this. Without it, /api/voices returns 503.
ELEVEN_LABS_API_KEY=
