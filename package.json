{
  "name": "nextjs-r3f-virtual-avatar",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based 3D virtual avatar that speaks with viseme-driven lipsync and blendshape facial expressions, built with Next.js and React Three Fiber.",
  "author": "Ali Shirzad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AliShirzad/nextjs-r3f-virtual-avatar.git"
  },
  "homepage": "https://github.com/AliShirzad/nextjs-r3f-virtual-avatar#readme",
  "bugs": {
    "url": "https://github.com/AliShirzad/nextjs-r3f-virtual-avatar/issues"
  },
  "keywords": [
    "nextjs",
    "react-three-fiber",
    "threejs",
    "webgl",
    "avatar",
    "lipsync",
    "visemes",
    "elevenlabs",
    "text-to-speech"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/lipsync.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "leva": "^0.10.1",
    "next": "15.5.23",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "postcss@<8.5.23": "^8.5.23",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "brace-expansion@<1.1.16": "^1.1.16",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=3.0.0 <5.0.7": "^5.0.7",
      "micromatch@<4.0.8": "^4.0.8",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "sharp@<0.35.0": "^0.35.3"
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.9",
    "typescript": "^5"
  }
}
